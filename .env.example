# ─────────────────────────────────────────────────────────────────────────────
# FIFA GraphQL API — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test

HTTPS_PORT=4443               # Port for the HTTPS GraphQL server
HTTP_PORT=4080                # Port for the HTTP → HTTPS redirect server

# ── TLS Certificates ─────────────────────────────────────────────────────────
# Development: run `npm run gen:certs` to generate self-signed certs in ./certs/
# Production:  point these at your CA-signed files (Let's Encrypt, ACM, etc.)
TLS_KEY_PATH=./certs/server.key
TLS_CERT_PATH=./certs/server.crt
# Optional: for mutual TLS or intermediate chain bundles
# TLS_CA_PATH=./certs/ca.crt

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# Use * only in development. In production, list exact origins.
CORS_ORIGINS=https://localhost:4443

# Minimum TLS version. Do not set below TLSv1.2.
TLS_MIN_VERSION=TLSv1.2

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max GraphQL requests per IP per window.
RATE_LIMIT_WINDOW_MS=60000    # 1 minute
RATE_LIMIT_MAX=100            # 100 requests per window

# ── GraphQL ───────────────────────────────────────────────────────────────────
# Maximum allowed query depth. Queries deeper than this are rejected (429→depth).
GRAPHQL_MAX_DEPTH=6

# Disable Apollo introspection in production (true = disabled).
DISABLE_INTROSPECTION=false

# ── JWT Authentication ────────────────────────────────────────────────────────
# REQUIRED: generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_use_a_64_byte_random_hex_string
JWT_REFRESH_SECRET=CHANGE_ME_use_a_different_64_byte_random_hex_string

# Token lifetimes (use ms-compatible strings: 15m, 1h, 7d, etc.)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed admin user created at startup (change these before first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# ── Data ──────────────────────────────────────────────────────────────────────
CSV_PATH=./srcData/player_stats.csv
